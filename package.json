{
  "name": "saep",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "guard:public-identifiers": "bash scripts/check-forbidden-public-identifiers.sh --repo",
    "lint": "turbo run lint",
    "prepare": "bash scripts/install-hooks.sh >/dev/null 2>&1 || true",
    "typecheck": "turbo run typecheck",
    "seed:bounties": "tsx scripts/seed_marketplace_bounties.ts",
    "bootstrap:proof-verifier-devnet": "tsx scripts/bootstrap_proof_verifier_devnet.ts",
    "set:task-market-dispute-window": "tsx scripts/set_task_market_dispute_window.ts",
    "smoke:devnet-x402": "tsx scripts/smoke_devnet_x402.ts",
    "smoke:devnet-verify-claim": "tsx scripts/smoke_devnet_verify_claim.ts",
    "smoke:compute-bonds": "tsx scripts/smoke_compute_bond_snapshots.ts",
    "smoke:compute-bonds:local": "tsx scripts/smoke_compute_bond_snapshots_local.ts",
    "smoke:indexer:render": "tsx scripts/smoke_render_indexer.ts",
    "smoke:python-distribution": "bash scripts/smoke_python_distribution.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "size": "node scripts/check-bundle-size.mjs apps/portal --build && node scripts/check-bundle-size.mjs apps/analytics --build",
    "test": "turbo run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "bufferutil",
      "utf-8-validate"
    ],
    "overrides": {
      "@solana/wallet-adapter-react": "0.15.35",
      "@tanstack/react-query": "5.62.0"
    }
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.3",
    "anchor-bankrun": "^0.5.0",
    "chai": "4.5.0",
    "eslint": "^9.25.1",
    "js-sha3": "^0.9.3",
    "mocha": "11.0.1",
    "prettier": "3.4.2",
    "solana-bankrun": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
