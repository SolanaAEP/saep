DATABASE_URL=postgres://saep:saep@localhost:5432/saep_indexer
SOLANA_CLUSTER=devnet
HELIUS_API_KEY=
# Or set SOLANA_RPC_URL directly to override:
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=XXXX
POLL_INTERVAL_MS=2000
RPC_PAGE_LIMIT=200
HEALTHCHECK_PORT=8080
RUST_LOG=info,saep_indexer=debug
# Optional — when set, the indexer uses Yellowstone gRPC streaming instead of
# JSON-RPC polling. Both required for the streaming path; either unset = poll.
# YELLOWSTONE_ENDPOINT=https://your-dedicated-node.helius-rpc.com
# YELLOWSTONE_TOKEN=
