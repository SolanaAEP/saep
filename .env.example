# ─── Solana ───────────────────────────────────────────────
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899     # localnet default
ANCHOR_WALLET=~/.config/solana/id.json

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet              # localnet | devnet | mainnet-beta
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# ─── Helius (required for indexer + staked RPC) ───────────
# Get a free key at https://dev.helius.xyz
HELIUS_API_KEY=
HELIUS_YELLOWSTONE_ENDPOINT=

# ─── Database (required for indexer + discovery) ──────────
# docker compose up -d  →  postgres available at default URL below
DATABASE_URL=postgres://saep:saep@localhost:5432/saep

# ─── Indexer / compute-bond snapshot sync ─────────────────
# Local snapshot-sync smoke flow expects the indexer to expose both ports:
#   INDEXER_ROLE=all
#   HEALTHCHECK_PORT=8080   # internal routes, including /compute-bonds/snapshots
#   API_PORT=8081           # public discovery API routes
INDEXER_ROLE=all
INDEXER_RUN_MIGRATIONS=1
HEALTHCHECK_PORT=8080
API_PORT=8081
INDEXER_INTERNAL_API_TOKEN=local-saep-indexer-token
INDEXER_INTERNAL_API_URL=http://127.0.0.1:8080
SAEP_INDEXER_PUBLIC_URL=http://127.0.0.1:8081
SAEP_DISCOVERY_URL=http://127.0.0.1:8790
SAEP_COMPUTE_BROKER_URL=http://127.0.0.1:8788
COMPUTE_PROVIDER_MODE=mock

# ─── Redis (required for IACP + proof-gen + x402) ────────
# docker compose up -d  →  redis available at default URL below
REDIS_URL=redis://localhost:6379

# ─── x402 gateway (optional managed demo flow) ────────────
SAEP_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# SAEP_OPERATOR_KEYPAIR=~/.config/solana/id.json
# X402_RECIPIENT_OPERATOR_KEYPAIR=~/.config/solana/recipient.json
# X402_TASK_DEADLINE_SECS=65
# X402_DEMO_PAYMENT_MINT=
# X402_DEMO_PAYMENT_AMOUNT=1000000
# X402_DEMO_RECIPIENT_DID=
# X402 smoke defaults:
#   pnpm smoke:devnet-x402
#   X402_SMOKE_DISPUTE_WINDOW_SECS=10

# ─── Treasury yield devnet smoke (optional Kamino operator path) ─
# Hosted Discovery is the default fallback in the smoke script; override for local services.
# SAEP_DISCOVERY_URL=https://saep-indexer-api.onrender.com
# SAEP_KAMINO_ROUTE_BUILDER_URL=
# SAEP_TREASURY_AGENT_DID_HEX=
# SAEP_TREASURY_STRATEGY_ID_HEX=
# SAEP_TREASURY_STRATEGY_LABEL=kamino-usdc-devnet
# SAEP_TREASURY_UNDERLYING_MINT=
# SAEP_TREASURY_RECEIPT_MINT=
# SAEP_TREASURY_KAMINO_PROGRAM=KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD
# SAEP_TREASURY_YIELD_MAX_BPS=2500
# SAEP_TREASURY_YIELD_CONFIG_BPS=2500
# Dry-run setup:
#   pnpm bootstrap:devnet-treasury-yield
# Dry-run smoke:
#   pnpm smoke:devnet-treasury-yield

# ─── Optional ─────────────────────────────────────────────
# RENDER_API_KEY=                              # only for Render deployments
# JITO_BLOCK_ENGINE=bundles.jito.wtf           # only for mainnet Jito bundles
# SWITCHBOARD_VRF_KEY=                         # only for dispute arbitration
